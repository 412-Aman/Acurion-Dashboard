# Demo can also be opened explicitly from the login screen.
# Leave false to require Firebase sign-in for transaction source pages.
VITE_DEMO_MODE=false

# The existing acurion-2bd21 web config is built in. These optional overrides
# must be filled together when connecting a different Firebase project.
# Web client config is public identification. Never place Admin/service-account
# private keys or credentials in VITE_ variables; they are bundled in the browser.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Defaults are the existing producer paths. Use exact paths in the new project.
VITE_FIREBASE_ALERTS_PATH=alerts
VITE_FIREBASE_TRANSACTIONS_PATH=transactions
VITE_FIREBASE_ACCOUNTS_PATH=accounts
VITE_FIREBASE_GRAPH_PATH=graphData
VITE_FIREBASE_AUDIT_PATH=auditLogs
VITE_FIREBASE_READ_LIMIT=500

# Email sign-in and registration are enabled by default.
# Set either flag false only to intentionally pause that action.
# Social providers are opt-in; enable them in Firebase too.
# These flags do not grant database access.
VITE_AUTH_ENABLED=true
VITE_AUTH_SIGNUP_ENABLED=true
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_GITHUB_ENABLED=false
