{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "transactions": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".write": false,
      ".indexOn": [
        "timestamp"
      ]
    },
    "accounts": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".write": false
    },
    "graphData": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".write": false
    },
    "networkReviews": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".write": false
    },
    "alerts": {
      ".read": "auth != null && auth.token.email_verified === true",
      "$alertId": {
        ".write": false,
        "status": {
          ".write": "data.parent().exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.isString() && newData.val().matches(/^(open|assigned|investigating|escalated|closed)$/) && (newData.val() !== 'closed' || root.child('roles').child(auth.uid).val().matches(/^(reviewer|admin)$/))"
        },
        "owner": {
          ".write": "data.parent().exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "disposition": {
          ".write": "data.parent().exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'no_further_action' || newData.val() === 'escalated_to_case')"
        },
        "analystNote": {
          ".write": "data.parent().exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 4000"
        },
        "reviewedAt": {
          ".write": "data.parent().exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "reviewedBy": {
          ".write": "data.parent().exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.val() === auth.uid"
        }
      }
    },
    "auditLogs": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".indexOn": [
        "timestamp"
      ],
      "$logId": {
        ".write": "!data.exists() && newData.exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
        ".validate": "newData.hasChildren(['timestamp', 'action', 'actor']) && newData.child('actor').val() === auth.uid && newData.child('action').isString() && newData.child('action').val().length <= 200"
      }
    },
    "hostDesk": {
      ".read": "auth != null && auth.token.email_verified === true",
      "status": {
        ".write": false
      },
      "lastCommand": {
        ".write": false
      },
      "command": {
        ".write": "auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val().matches(/^(reviewer|admin)$/)",
        ".validate": "newData.hasChildren(['id', 'action', 'by', 'at']) && newData.child('id').isString() && newData.child('id').val().length <= 64 && newData.child('action').isString() && newData.child('action').val().matches(/^(start|stop)$/) && newData.child('by').val() === auth.uid && newData.child('at').val() === now"
      }
    },
    "uploadJobs": {
      ".read": "auth != null && auth.token.email_verified === true",
      ".indexOn": [
        "createdAt"
      ],
      "$jobId": {
        ".write": "(!data.exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer') || (data.exists() && newData.exists() && auth != null && auth.token.email_verified === true && data.child('by').val() === auth.uid)",
        ".validate": "newData.hasChildren(['by', 'byName', 'fileName', 'bytes', 'packedBytes', 'chunks', 'sha256', 'status', 'createdAt']) && newData.child('by').val() === auth.uid && (data.exists() || (newData.child('status').val() === 'uploading' && newData.child('createdAt').val() === now))",
        "by": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "byName": {
          ".validate": "newData.isString() && newData.val().length <= 120 && (!data.exists() || newData.val() === data.val())"
        },
        "fileName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200 && (!data.exists() || newData.val() === data.val())"
        },
        "bytes": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 104857600 && (!data.exists() || newData.val() === data.val())"
        },
        "packedBytes": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 104857600 && (!data.exists() || newData.val() === data.val())"
        },
        "chunks": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 300 && (!data.exists() || newData.val() === data.val())"
        },
        "columns": {
          ".validate": "newData.isString() && newData.val().length <= 4000 && (!data.exists() || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && (!data.exists() ? newData.val() === 'uploading' : ((data.val() === 'uploading' && newData.val().matches(/^(queued|cancelled)$/)) || (data.val() === 'queued' && newData.val() === 'cancelled') || (data.val() === 'columns' && newData.val().matches(/^(queued|cancelled)$/))))"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "sha256": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/) && (!data.exists() || newData.val() === data.val())"
        },
        "mapping": {
          ".validate": "data.parent().child('status').val() === 'columns' && newData.hasChildren()",
          "$field": {
            ".validate": "$field.matches(/^(transaction_id|sender|receiver|amount|timestamp|time_of_day|amount_received|payment_currency|receiving_currency|payment_format|sender_bank|receiver_bank|label|date_order)$/) && newData.isString() && newData.val().length <= 200"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "uploadFiles": {
      "$jobId": {
        "$chunk": {
          ".write": "!data.exists() && newData.exists() && auth != null && auth.token.email_verified === true && root.child('uploadJobs').child($jobId).child('by').val() === auth.uid && root.child('uploadJobs').child($jobId).child('status').val() === 'uploading'",
          ".validate": "newData.isString() && newData.val().length <= 700000 && $chunk.matches(/^c[0-9]{3}$/)"
        }
      }
    },
    "caseWorkspaces": {
      "$team": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
        "vault": {
          ".write": "!data.exists() && auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val().matches(/^(reviewer|admin)$/)",
          ".validate": "newData.hasChildren(['salt', 'iterations', 'check', 'createdBy']) && newData.child('createdBy').val() === auth.uid && newData.child('iterations').val() >= 100000"
        },
        "payload": {
          ".write": "auth != null && auth.token.email_verified === true && root.child('roles').child(auth.uid).val() !== 'viewer'",
          ".validate": "newData.hasChildren(['iv', 'ct', 'version', 'updatedBy', 'updatedAt']) && newData.child('updatedBy').val() === auth.uid && newData.child('version').isNumber() && ((!data.exists() && newData.child('version').val() === 1) || (data.exists() && newData.child('version').val() === data.child('version').val() + 1))"
        }
      }
    }
  }
}
